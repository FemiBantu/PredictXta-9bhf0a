# PredictXta Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── Supabase (client-side — safe to expose) ──────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── App environment ──────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development

# ─── Feature flags (dev only) ─────────────────────────────────────────────────
# Set to 'true' only in __DEV__ builds to enable DEV_MOCK_MATCHES rendering.
# This env var MUST NOT be set in preview or production builds.
# EXPO_PUBLIC_USE_MOCK_DATA=false

# ─── Server-side secrets (Edge Functions / Supabase Vault ONLY) ──────────────
# These secrets must NEVER be set as EXPO_PUBLIC_ variables.
# Configure them via: Supabase Dashboard > Edge Functions > Secrets
# or via: eas secret:create --scope project --name KEY --value VALUE
#
# SUPABASE_SERVICE_ROLE_KEY=         (Vault / EAS secret — never client-side)
# OPENAI_API_KEY=                    (Vault / EAS secret)
# GEMINI_API_KEY=                    (Vault / EAS secret)
# GROQ_API_KEY=                      (Vault / EAS secret)
# API_FOOTBALL_KEY=                  (Vault / EAS secret)
# SPORTSDB_KEY=                      (Vault / EAS secret)
# HIGHLIGHTLY_KEY=                   (Vault / EAS secret)
# FIREBASE_SERVER_KEY=               (Vault / EAS secret)

# ─── EAS Submit (set via eas secret, not here) ────────────────────────────────
# APPLE_ID=your@email.com
# APP_STORE_CONNECT_APP_ID=123456789
# APPLE_TEAM_ID=XXXXXXXXXX
